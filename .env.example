# AIGrowSutra environment variables
# Copy this file to .env (local) or set these in your host's dashboard (Render/Vercel/Railway).
# After you add DATABASE_URL, ALL data (prompts, leads, subscribers) is saved
# in your Supabase Postgres database instead of the local SQLite file.

# --------------------------- SUPABASE (recommended, free) ---------------------------
# 1. Free account at https://supabase.com -> New project
# 2. Project Settings -> Database -> Connection string -> "Session pooler" -> URI
# 3. Paste it here. It looks like:
#
# DATABASE_URL=postgresql://postgres.abcdefghijk:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# --------------------------- NEON (alternative, free) -------------------------------
# DATABASE_URL=postgres://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional. Render sets this automatically. Default 3000 locally.
# PORT=3000
